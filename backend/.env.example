# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=dont_make_me_say

# Model access. Set one key. OpenRouter is used when its key is present,
# even if a DeepSeek key is also set. Direct DeepSeek is the fallback.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Direct DeepSeek, used only when OPENROUTER_API_KEY is unset:
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Optional per-difficulty model slugs. Unset values use the roster in
# src/config/models.ts. OpenRouter slugs only work with an OpenRouter key.
# LLM_MODEL_EASY=deepseek/deepseek-chat-v3.1
# LLM_MODEL_NORMAL=google/gemini-2.5-flash-lite
# LLM_MODEL_HARD=qwen/qwen3.6-flash
# LLM_MODEL_NIGHTMARE=deepseek/deepseek-v4.1-flash-1017

# Oldest conversations are deleted once the database reaches this many bytes.
# Default is 1 GiB. The scoreboard row, including the winning reply, is kept.
# DB_SIZE_LIMIT_BYTES=1073741824

# Passphrase gate
# The site access passphrase is computed as: {PASSPHRASE_NAME}{Month}{Year}
# e.g. with PASSPHRASE_NAME=Adam the June 2026 passphrase is "AdamJune2026"
# Change this to your own name or any string before demoing.
PASSPHRASE_NAME=Adam

# Dev conveniences
# Prints the current passphrase to the backend console on startup.
# The server default is false when this variable is omitted.
LOG_PASSPHRASE=true
# Set to true to enable a cheat trigger that forces an instant win (dev only)
ENABLE_CHEAT_MODE=false
CHEAT_TRIGGER=philliburton
# Publishes every target word at GET /api/target-word/list. Leave false.
ENABLE_WORD_LIST=false
# Set to 1 when the API sits behind a reverse proxy so rate limits use the
# client address. Leave unset in local development.
# TRUST_PROXY=1