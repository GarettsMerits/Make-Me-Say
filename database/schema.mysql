-- dont-make-me-say Database Schema
-- Updated: May 2026
-- Language: MySQL

CREATE DATABASE IF NOT EXISTS dont_make_me_say
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE dont_make_me_say;

-- Leaderboard table for storing user scores
CREATE TABLE IF NOT EXISTS leaderboard (
    id INT AUTO_INCREMENT PRIMARY KEY,
    player_name VARCHAR(255) NOT NULL,
    token_count INT NOT NULL,
    target_word VARCHAR(100) NOT NULL,
    difficulty ENUM('easy', 'normal', 'hard', 'nightmare') NOT NULL DEFAULT 'normal',
    llm_victory_message TEXT,
    completed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    session_id VARCHAR(255),
    
    UNIQUE KEY uniq_leaderboard_session (session_id),
    INDEX idx_token_count (token_count),
    INDEX idx_completed_at (completed_at),
    INDEX idx_target_word (target_word),
    INDEX idx_difficulty (difficulty),
    INDEX idx_diff_tokens (difficulty, token_count)
) ENGINE=InnoDB;

-- Game sessions table for tracking active games
CREATE TABLE IF NOT EXISTS game_sessions (
    id VARCHAR(255) PRIMARY KEY,
    target_word VARCHAR(100) NOT NULL,
    difficulty ENUM('easy', 'normal', 'hard', 'nightmare') NOT NULL DEFAULT 'normal',
    current_tokens INT DEFAULT 0,
    messages JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    last_activity TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    completed BOOLEAN DEFAULT FALSE,
    score_submitted BOOLEAN NOT NULL DEFAULT FALSE,
    declined BOOLEAN NOT NULL DEFAULT FALSE,
    
    INDEX idx_created_at (created_at),
    INDEX idx_last_activity (last_activity),
    INDEX idx_completed (completed)
) ENGINE=InnoDB;

-- Target words table for managing available words
CREATE TABLE IF NOT EXISTS target_words (
    id INT AUTO_INCREMENT PRIMARY KEY,
    word VARCHAR(100) NOT NULL UNIQUE,
    difficulty ENUM('easy', 'normal', 'hard', 'nightmare') NOT NULL DEFAULT 'normal',
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    -- Word statistics
    assignment_count INT NOT NULL DEFAULT 0,        -- times this word was assigned to a player
    reroll_count INT NOT NULL DEFAULT 0,            -- times a player rerolled off this word (no messages sent)
    total_games_played INT NOT NULL DEFAULT 0,      -- games where at least one message was sent with this word
    win_count INT NOT NULL DEFAULT 0,               -- times players have won with this word
    avg_tokens_to_win DECIMAL(10,2) DEFAULT NULL,   -- average player input tokens to win
    max_tokens_to_win INT DEFAULT NULL,             -- most tokens a player has input to win
    min_tokens_to_win INT DEFAULT NULL,             -- least tokens a player has input to win
    
    INDEX idx_difficulty (difficulty),
    INDEX idx_active (is_active)
) ENGINE=InnoDB;

-- API usage tracking for rate limiting and analytics
CREATE TABLE IF NOT EXISTS api_usage (
    id INT AUTO_INCREMENT PRIMARY KEY,
    ip_address VARCHAR(45),
    endpoint VARCHAR(255),
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    user_agent TEXT,
    
    INDEX idx_ip_timestamp (ip_address, timestamp),
    INDEX idx_endpoint (endpoint)
) ENGINE=InnoDB;

