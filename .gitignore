# Environment files — never commit real credentials
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# Database — schema is committed, data exports are not
database/*.sql.bak
database/dump*.sql
database/export*.sql

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
backend/dist/
frontend/build/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Private / personal files (resume drafts, notes, etc.)
private/
